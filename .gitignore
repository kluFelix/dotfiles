.local

# Dictionaries for nvim spell check (are downloaded automatically when missing)
*.spl
*.sug

# Nvim plugin versions are PINNED ON PURPOSE: lazy.nvim installs exactly these
# commits on first launch, so a fresh machine gets the known-good plugin set.
# Do not ignore this file (see README → NeoVim).

# Dadbod stores a connection per JSON file, including its password.
.config/nvim/db_ui/

# opencode's plugin/MCP deps, regenerated by npm on demand
node_modules

# Personal + machine-specific git config (identity, credential helper, internal CA bundles)
.gitconfig.local

# Only the ssh config is tracked. Keys, known_hosts and authorized_keys never are.
.ssh/*
!.ssh/config
