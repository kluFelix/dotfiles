{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "disabled_providers": ["opencode"],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://192.168.112.200:11434"
      },
      "models": {
        "Devstral-Small-2 24b 256k": {
          "name": "Devstral-Small-2 24b - 256k",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "Qwen3.6-35b-a3b 128k reasoning": {
          "name": "Qwen3.6 35b-a3b - 128k",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "Qwen3.6-35b-a3b 256k reasoning": {
          "name": "Qwen3.6 35b-a3b - 256k",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "Qwen3.5-27b 100k reasoning": {
          "name": "Qwen3.5 27b - 100k",
          "limit": {
            "context": 100000,
            "output": 32768
          }
        },
        "Qwen3.5-27b 256k reasoning": {
          "name": "Qwen3.5 27b - 256k",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "Gemma4 26b-a4b 256k reasoning": {
          "name": "Gemma4 26b-a4b 256k reasoning",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "SearXNG": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs", "--command", "npx", "-y", "mcp-searxng"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://192.168.112.200:8888"
      }
    },
    "Mermaid": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs", "--command", "npx", "-y", "mcp-mermaid"],
      "enabled": false,
      "environment": {
      }
    },
    "NixOS": {
      "type": "local",
      "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
      "enabled": false,
      "environment": {
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny"
  },
  "tools": {
    "write": true,
    "bash": true,
    "webfetch": false,
    "question": false,
    "list": false,
    "skill": true,
    "todowrite": false,
    "todoread": false
  },

  "agent": {
    "general": {
      "mode": "subagent",
      "tools": {
        "SearXNG_*": true,
        "skill": true
      },
      "permission": {
        "skill": {
          "caveman": "allow"
        }
      }
    },
    "explore": {
      "mode": "subagent",
      "tools": {
        "SearXNG_*": true,
        "skill": true
      },
      "permission": {
        "skill": {
          "caveman": "allow"
        }
      }
    }
  }
}
