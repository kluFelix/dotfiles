{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",

  "default_agent": "plan",

  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
    { "action": "provider.use", "resource": "exa", "effect": "deny" },
    { "action": "tool.use", "resource": "question:*", "effect": "deny" },
    { "action": "tool.use", "resource": "webfetch:*", "effect": "deny" }
  ],

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "caveman", "effect": "allow" }
  ],

  "providers": {
    "llama swap": {
      "name": "llama swap (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.112.200:11434/v1"
      },
      "models": {
        "Qwen3.8-27b": {
          "name": "Qwen3.8 27b",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "xhigh",
              "body": {
                "reasoning_effort": "xhigh"
              }
            },
            {
              "id": "med",
              "body": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "low",
              "body": {
                "reasoning_effort": "low"
              }
            }
          ],
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },

        "GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },

  "compaction": {
    "auto": false
  },

  "mcp": {
    "servers": {
      "Firecrawl": {
        "type": "local",
        "command": ["sh", "-c", "if [ ! -w \"$HOME\" ]; then npm_config_cache=\"$PWD/.npm-cache\"; export npm_config_cache; fi; if command -v npx >/dev/null 2>&1; then exec npx -y firecrawl-mcp@3.33.2; else exec nix shell nixpkgs#nodejs --command npx -y firecrawl-mcp@3.33.2; fi"],
        "environment": {
          "FIRECRAWL_API_URL": "http://192.168.112.200:3002"
        }
      },
      "NixOS": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
        "disabled": true,
        "environment": {
        }
      }
    }
  },

  "agents": {
    "general": {
      "mode": "subagent",
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "Firecrawl_*", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "mode": "subagent",
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "Firecrawl_*", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
