{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096
  },
  "experimental": {
    "openTelemetry": false
  },
  "disabled_providers": ["exa", "opencode"],

  "default_agent": "plan",
  "provider": {
    "llama swap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama swap (local)",
      "options": {
        "baseURL": "http://192.168.112.200:11434/v1"
      },
      "models": {
        "Qwen3.8-27b": {
          "name": "Qwen3.8 27b",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "xhigh": {
              "name": "Max Reasoning (xhigh)",
              "body": {
                "reasoning_effort": "xhigh"
              }
            },
            "med": {
              "name": "Balanced (medium)",
              "body": {
                "reasoning_effort": "medium"
              }
            },
            "low": {
              "name": "Fast (low)",
              "body": {
                "reasoning_effort": "low"
              }
            }
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },

        "GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },

  "compaction": {
    "auto": false
  },

  "mcp": {
    "Firecrawl": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs", "--command", "npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_URL": "http://192.168.112.200:3002"
      }
    },
    "Mermaid": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs", "--command", "npx", "-y", "mcp-mermaid"],
      "enabled": false,
      "environment": {
      }
    },
    "NixOS": {
      "type": "local",
      "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
      "enabled": false,
      "environment": {
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "skill": {
      "caveman": "allow"
    }
  },
  "tools": {
    "write": true,
    "bash": true,
    "webfetch": false,
    "question": false,
    "list": false,
    "skill": true,
    "todowrite": false,
    "todoread": false
  },

  "agent": {
    "general": {
      "mode": "subagent",
      "tools": {
        "Firecrawl_*": true,
        "skill": true
      }
    },
    "explore": {
      "mode": "subagent",
      "tools": {
        "Firecrawl_*": true,
        "skill": true
      }
    }
  }
}
